#!/usr/bin/env bash
set -euo pipefail

echo "[postBuild] start"

# ---- detect conda prefix ----
PREFIX="$(python -c 'import sys; print(sys.prefix)')"
echo "[postBuild] sys.prefix=$PREFIX"

# ---- install toolchain + verilator + JDK headers ----
# gxx_linux-64: 提供 g++ 且支持 -std=gnu++14
# openjdk: 提供 jni.h
if command -v mamba >/dev/null 2>&1; then
  mamba install -y -c conda-forge verilator openjdk gxx_linux-64
else
  conda install -y -c conda-forge verilator openjdk gxx_linux-64
fi

# ---- create ~/bin and wrappers (they are recreated every launch, so it's "persistent" via repo) ----
mkdir -p "$HOME/bin"

# 1) verilator wrapper: locate real verilator + add JNI include + force C++14 for Verilator make
cat > "$HOME/bin/verilator" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

# Locate real verilator
REAL=""
if [ -n "${VERILATOR_REAL:-}" ] && [ -x "${VERILATOR_REAL}" ]; then
  REAL="${VERILATOR_REAL}"
elif [ -n "${CONDA_PREFIX:-}" ] && [ -x "${CONDA_PREFIX}/bin/verilator" ]; then
  REAL="${CONDA_PREFIX}/bin/verilator"
else
  PY="$(command -v python3 || command -v python)"
  PFX="$("$PY" -c 'import sys; print(sys.prefix)')"
  if [ -x "$PFX/bin/verilator" ]; then
    REAL="$PFX/bin/verilator"
  fi
fi

if [ -z "$REAL" ]; then
  echo "[verilator-wrapper] ERROR: cannot find real verilator binary" >&2
  exit 127
fi

# JAVA_HOME for jni.h
if [ -z "${JAVA_HOME:-}" ] && command -v javac >/dev/null 2>&1; then
  JAVAC_PATH="$(readlink -f "$(command -v javac)")"
  export JAVA_HOME="$(dirname "$(dirname "$JAVAC_PATH")")"
fi

# Force C++14 and inject jni include for the C++ compilation stage (Verilator's make)
export USER_CXXFLAGS="${USER_CXXFLAGS:-} -std=gnu++14"
if [ -n "${JAVA_HOME:-}" ]; then
  export USER_CPPFLAGS="${USER_CPPFLAGS:-} -I${JAVA_HOME}/include -I${JAVA_HOME}/include/linux"
fi

exec "$REAL" "$@"
EOF
chmod +x "$HOME/bin/verilator"

# 2) run_spinal_test wrapper: ensures env vars exist even if upstream script doesn't set them
cat > "$HOME/bin/run_spinal_test" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

# Ensure JAVA_HOME exists for jni.h
if [ -z "${JAVA_HOME:-}" ] && command -v javac >/dev/null 2>&1; then
  JAVAC_PATH="$(readlink -f "$(command -v javac)")"
  export JAVA_HOME="$(dirname "$(dirname "$JAVAC_PATH")")"
fi

# Ensure Verilator C++ model compilation uses C++14
export USER_CXXFLAGS="${USER_CXXFLAGS:-} -std=gnu++14"
if [ -n "${JAVA_HOME:-}" ]; then
  export USER_CPPFLAGS="${USER_CPPFLAGS:-} -I${JAVA_HOME}/include -I${JAVA_HOME}/include/linux"
fi

# Prefer the original installed tool if present
if [ -x "$HOME/.local/bin/run_spinal_test" ]; then
  exec "$HOME/.local/bin/run_spinal_test" "$@"
else
  echo "[run_spinal_test-wrapper] ERROR: $HOME/.local/bin/run_spinal_test not found" >&2
  exit 127
fi
EOF
chmod +x "$HOME/bin/run_spinal_test"

# ---- ensure ~/bin is on PATH for terminals ----
# Jupyter terminal usually reads ~/.bashrc
grep -q 'export PATH="$HOME/bin:$PATH"' "$HOME/.bashrc" 2>/dev/null || \
  echo 'export PATH="$HOME/bin:$PATH"' >> "$HOME/.bashrc"

echo "[postBuild] done"
